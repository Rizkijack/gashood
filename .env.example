# GasHood — template environment variables (BUILD_STEPS.md Langkah 3)
# Copy file ini ke .env.local lalu sesuaikan bila perlu.
# Semua variabel di bawah bersifat PUBLIK (di-embed ke bundle client via import.meta.env)
# — jangan simpan secret/API key di sini.

# RPC endpoint Robinhood Chain L2 mainnet
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com/

# Blockscout API v2 (enrichment / fallback data)
VITE_BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api/v2

# Interval polling block dalam ms (di-clamp ke 1000..10000 oleh gas-collector)
VITE_POLLING_INTERVAL=3000

# Ukuran ring buffer transaksi terakhir di store
VITE_MAX_RECENT_TXS=200
